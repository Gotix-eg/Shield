generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model Company {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  address            String?
  logoUrl            String?
  phone              String?
  status             CompanyStatus       @default(DEMO)
  maxSeats           Int                 @default(3)
  subscriptionEnds   DateTime?
  registeredEmail    String?
  users              User[]
}

model User {
  id                    Int                  @id @default(autoincrement())
  name                  String
  email                 String               @unique
  passwordHash          String
  role                  Role                 @default(STAFF)
  createdAt             DateTime             @default(now())
  address               String?
  phone                 String?
  companyId             Int?
  notifications         Notification[]
  company               Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions           UserPermission[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  name  String
  users UserPermission[]
}

model UserPermission {
  userId       Int
  permissionId Int
  allowed      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@id([userId, permissionId])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum CompanyStatus {
  DEMO
  ACTIVE
  SUSPENDED
}

// ═══════════════════════════════════════════════
//  WEBSITE CMS MODELS
// ═══════════════════════════════════════════════

model WebsiteHero {
  id          Int      @id @default(autoincrement())
  companyId   Int
  tagline     String
  titleFirst  String
  titleSecond String
  subtitle    String   @db.Text
  ctaBook     String
  ctaPortal   String
  updatedAt   DateTime @updatedAt
}

model WebsiteAbout {
  id           Int      @id @default(autoincrement())
  companyId    Int
  tagline      String
  title        String
  description1 String   @db.Text
  description2 String   @db.Text
  updatedAt    DateTime @updatedAt
}

model WebsiteTeamMember {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  role      String
  bio       String   @db.Text
  focus     String[] // Array of specialization tags
  imageUrl  String
  videoUrl  String?
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsitePractice {
  id        Int      @id @default(autoincrement())
  companyId Int
  slug      String   // e.g. "ip", "corporate"
  title     String
  shortDesc String   @db.Text
  longDesc  String   @db.Text
  icon      String   // Lucide icon name
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteAward {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  institution String
  description String   @db.Text
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebsiteContact {
  id           Int      @id @default(autoincrement())
  companyId    Int
  officeTitle  String
  address      String   @db.Text
  phone        String
  email        String
  workingHours String
  updatedAt    DateTime @updatedAt
}

model WebsiteFaq {
  id        Int      @id @default(autoincrement())
  companyId Int
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultationRequest {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  email       String
  company     String?
  phone       String?
  summary     String?  @db.Text
  practiceId  String?  // slug reference to WebsitePractice
  date        String   // Selected date
  timeSlot    String   // Selected time slot
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes       String?  @db.Text // Admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteScheduleSlot {
  id        Int      @id @default(autoincrement())
  companyId Int
  label     String   // e.g. "09:30 AM - 10:00 AM"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WebsitePortalDemo {
  id                Int      @id @default(autoincrement())
  companyId         Int
  title             String   @default("Shield Advocates Client Portal Preview")
  subtitle          String   @db.Text
  clientName        String
  matterName        String
  caseNumber        String
  clientEmail       String
  courtName         String
  currentStatus     String
  assignedAttorneys String   // Comma-separated list of attorneys
  milestones        Json     // Array of milestones: [{ title, date, status, description }]
  documents         Json     // Array of documents: [{ name, size, type, date, url }]
  updatedAt         DateTime @updatedAt
}
